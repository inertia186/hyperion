{
  "name": "hyperion",
  "private": true,
  "engines": {
    "node": ">=24 <25",
    "yarn": ">=1.22 <2"
  },
  "scripts": {
    "build": "esbuild app/javascript/application.js --bundle --outdir=app/assets/builds --public-path=/assets",
    "build:css": "sass ./app/assets/stylesheets/application.scss:./app/assets/builds/application.css --load-path=node_modules --no-source-map --quiet-deps --silence-deprecation=import"
  },
  "dependencies": {
    "@hotwired/stimulus": "^3.2.2",
    "@rails/actioncable": "^7.2.0",
    "@rails/activestorage": "^7.2.0",
    "@rails/ujs": "^7.1.3",
    "bootstrap": "^4.6.2",
    "jquery": "^3.7.1",
    "jquery-ui": "^1.14.1",
    "popper.js": "^1.16.1",
    "select2": "4.1.0-rc.0",
    "turbolinks": "^5.2.0"
  },
  "version": "0.1.0",
  "devDependencies": {
    "esbuild": "^0.25.0",
    "sass": "^1.93.0"
  }
}
